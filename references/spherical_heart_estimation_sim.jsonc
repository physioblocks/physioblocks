{
    "type": "spherical_heart_estimation_ukf",
    "data": {
        // the measurements file should provide for the simulation length
        //  * proximal pressure in mmHg
        //  * proximal flow in mL/s
        "measurements": {
            "filepath": "synthetic_data/spherical_heart_measurements.csv"
        }
    },
    "preprocesses":{
        "measurements_mapping": {
            "mapping": {
                // replace 'proximal_pressure' and 'proximal_flow' key with your measurement names in the file.
                "proximal_pressure": "measurement.aorta_proximal.blood_pressure",
                "proximal_flow": "measurement.valve_arterial.flux"
            }
        }
    },
    "parameters": {
        "time.duration": 10.0,
        "aorta_distal.blood_pressure.init": 10760.0,
        "aorta_proximal.blood_pressure.init": 10760.0,
        "cavity.blood_pressure.init": "atrial.blood_pressure.max", // initialization with an open atrial valve
        "heart_radius": 0.0340,
        "heart_thickness": 0.0113,
        "heart_contractility.init": 1.0e5,
        "heart_rate": 60.0, // in beats / min
        "venous.blood_pressure": 1600.0,
        "atrial.blood_pressure.min": 450.0,
        "atrial.blood_pressure.max": 900.0,
        "circulation_aorta_proximal.resistance": 7.0e6,
        "circulation_aorta_distal.resistance.init": 1.0e8, // Initial guess for distal resistance
        "cavity.dynamics.hyperelastic_cst": [444.0, 2.9, 69.0, 6.5]
    }
}
