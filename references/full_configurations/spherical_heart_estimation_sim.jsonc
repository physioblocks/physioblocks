{
    "type": "estimation_simulation",
    "simulation_options": {
        "min_step": 6.25e-05,
        "model_noise_stdev": {
            "aorta_proximal.blood_pressure": 0.0002,
            "aorta_distal.blood_pressure": 0.0002,
            "valve_atrium.flux": 0.0002,
            "valve_arterial.flux": 0.0002,
            "cavity.dynamics.disp": 0.0,
            "cavity.velocity_law.vel": 0.0,
            "cavity.velocity_law.accel": 0.0,
            "cavity.rheology.fib_deform": 0.0002,
            "cavity.rheology.active_law.active_stiffness": 0.0002,
            "cavity.rheology.active_law.active_energy_sqrt": 0.0002,
            "cavity.rheology.active_law.active_tension_discr": 0.0002,
            "cavity.blood_pressure": 0.0002,
            "circulation_aorta_distal.resistance": 0.0002,
            "heart_contractility": 0.0002
        },
        "transformation_operators": {
            "cavity.rheology.active_law.active_stiffness": {
                "type": "tanh_transform",
                "scaling_factor": 100000.0,
                "upper_bound": "cavity.rheology.active_law.crossbridge_stiffness",
                "lower_bound": 0.0
            },
            "circulation_aorta_distal.resistance": {
                "type": "power_transform",
                "scaling_factor": 100000000.0
            },
            "heart_contractility": {
                "type": "power_transform",
                "scaling_factor": 100000.0
            }
        },
        "parallelize": "True"
    },
    "time": {
        "type": "range",
        "step_size": "time.step_size",
        "start": "time.start",
        "length": "time.duration"
    },
    "filter": {
        "type": "unscented_kalman_filter"
    },
    "solver": {
        "type": "newton_solver",
        "tolerance": 1e-09,
        "iteration_max": 10
    },
    "plots": {
        "main_plot": {
            "type": "plot",
            "inputs": [
                "main"
            ],
            "abscissas": "time"
        },
        "PV-Loop_plot": {
            "type": "plot",
            "rows_height": 1000,
            "traces": {
                "Ventricle Pressure": {
                    "matches": "{subplot_id}.blood_pressure",
                    "style": {
                        "mode": "lines",
                        "line": {
                            "color": "red"
                        },
                        "fill": "toself",
                        "fillcolor": "rgba(255, 0, 0, 0.2)"
                    }
                },
                "ESPVR": {
                    "matches": "{subplot_id}.dynamics.ESPVR",
                    "style": {
                        "mode": "lines",
                        "line": {
                            "color": "green"
                        }
                    }
                },
                "EDPVR": {
                    "matches": "{subplot_id}.dynamics.EDPVR",
                    "style": {
                        "mode": "lines",
                        "line": {
                            "color": "blue"
                        }
                    }
                }
            },
            "abscissas": "cavity.volume",
            "layout": {
                "annotations": [
                    {
                        "text": "Cavity PV Loop"
                    }
                ],
                "xaxis_title": "Volume (mL)",
                "yaxis_title": "Pressure (mmHg)"
            },
            "subplots": [
                "cavity"
            ],
            "inputs": [
                "last_cycle",
                "espvr-edpvr"
            ]
        },
        "estimations": {
            "type": "plot",
            "traces": {
                "value": {
                    "matches": "{subplot_id}",
                    "style": {
                        "mode": "lines",
                        "line": {
                            "color": "blue"
                        },
                        "legendgroup": "value"
                    }
                },
                "stdev_min": {
                    "matches": "stdev_min.{subplot_id}",
                    "style": {
                        "mode": "lines",
                        "line": {
                            "color": "blue",
                            "width": 1.0
                        },
                        "legendgroup": "stdev"
                    },
                    "showlegend": 0
                },
                "stdev": {
                    "matches": "stdev_plus.{subplot_id}",
                    "style": {
                        "mode": "lines",
                        "line": {
                            "color": "blue",
                            "width": 1.0
                        },
                        "fill": "tonexty",
                        "fillcolor": "rgba(0, 0, 255, 0.2)",
                        "legendgroup": "stdev"
                    }
                },
                "measurement": {
                    "matches": "measurement.{subplot_id}",
                    "style": {
                        "mode": "lines",
                        "line": {
                            "color": "green",
                            "dash": "dash"
                        },
                        "legendgroup": "measurement"
                    }
                }
            },
            "abscissas": "time",
            "subplots": [
                "aorta_proximal.blood_pressure",
                "valve_arterial.flux",
                "circulation_aorta_distal.resistance",
                "heart_contractility",
                "cavity.blood_pressure",
                "atrial.blood_pressure",
                "aorta_distal.blood_pressure",
                "valve_atrium.flux",
                "cavity.volume",
                "cavity.dynamics.disp",
                "cavity.velocity_law.vel",
                "cavity.velocity_law.accel",
                "cavity.rheology.fib_deform",
                "active_law.activation",
                "cavity.rheology.active_law.active_stiffness",
                "cavity.rheology.active_law.active_energy_sqrt",
                "cavity.rheology.active_law.active_tension_discr"
            ],
            "inputs": [
                "main",
                "measurements"
            ]
        }
    },
    "parameters": {
        "time.start": 0.0,
        "time.step_size": 0.001,
        "heartbeat_duration": {
            "type": "product",
            "factors": [
                60.0
            ],
            "inverses": [
                "heart_rate"
            ]
        },
        "pleural.pressure": 0.0,
        "diastole_scaling_factor": 0.8,
        "time.step": 0.001,
        "cavity.dynamics.vol_mass": 1000.0,
        "cavity.dynamics.damping_coef": 70.0,
        "cavity.velocity_law.scheme_ts_hht": 0.4,
        "cavity.rheology.series_stiffness": 100000000.0,
        "cavity.rheology.damping_parallel": 70.0,
        "cavity.rheology.active_law.starling_abscissas": [
            -0.1668,
            -0.0073,
            0.0534,
            0.0969,
            0.1326,
            0.2016,
            0.4663,
            0.9187,
            1.1762
        ],
        "cavity.rheology.active_law.starling_ordinates": [
            0.0,
            0.5614,
            0.7748,
            0.8933,
            0.9618,
            1.0,
            1.0,
            0.1075,
            0.0
        ],
        "cavity.rheology.active_law.destruction_rate": 12.0,
        "cavity.rheology.active_law.crossbridge_stiffness": 273000.0,
        "active_law.activation.min": -20.0,
        "active_law.activation.max": 35.0,
        "conductance_iso": 5e-15,
        "valve_atrium.inductance": 1000.0,
        "valve_atrium.conductance": 9e-06,
        "valve_arterial.inductance": 30000.0,
        "valve_arterial.conductance": 1.3e-05,
        "capacitance_valve.capacitance": 5e-12,
        "valve_atrium.scheme_ts_flux": 0.25,
        "valve_arterial.scheme_ts_flux": 0.25,
        "circulation_aorta_proximal.capacitance": 2e-10,
        "circulation_aorta_distal.capacitance": 1.2e-08,
        "time.duration": 10.0,
        "aorta_distal.blood_pressure.init": 10760.0,
        "aorta_proximal.blood_pressure.init": 10760.0,
        "cavity.blood_pressure.init": "atrial.blood_pressure.max",
        "heart_radius": 0.034,
        "heart_thickness": 0.0113,
        "heart_contractility.init": 100000.0,
        "heart_rate": 60.0,
        "venous.blood_pressure": 1600.0,
        "atrial.blood_pressure.min": 450.0,
        "atrial.blood_pressure.max": 900.0,
        "circulation_aorta_proximal.resistance": 7000000.0,
        "circulation_aorta_distal.resistance.init": 100000000.0,
        "cavity.dynamics.hyperelastic_cst": [
            444.0,
            2.9,
            69.0,
            6.5
        ]
    },
    "filter_type": "unscented_kalman_filter",
    "net": {
        "type": "net",
        "flux_dof_definitions": {
            "blood_flow": "blood_pressure"
        },
        "nodes": [
            "cavity",
            "atrial",
            "aorta_proximal",
            "aorta_distal",
            "venous"
        ],
        "blocks": {
            "cavity": {
                "type": "block_description",
                "model_type": "spherical_cavity_block",
                "time": "time",
                "flux_type": "blood_flow",
                "disp": "cavity.dynamics.disp",
                "radius": "heart_radius",
                "thickness": "heart_thickness",
                "alternative_types": {
                    "cavity.asymptotic": "spherical_cavity_block_asymptotic"
                },
                "submodels": {
                    "dynamics": {
                        "type": "model_description",
                        "model_type": "spherical_dynamics",
                        "time": "time",
                        "fib_deform": "cavity.rheology.fib_deform",
                        "pressure": "cavity.blood_pressure",
                        "pressure_external": "pleural.pressure",
                        "vel": "cavity.velocity_law.vel",
                        "radius": "heart_radius",
                        "thickness": "heart_thickness",
                        "series_stiffness": "cavity.rheology.series_stiffness",
                        "alternative_types": {
                            "cavity.asymptotic": "spherical_dynamics_asymptotic"
                        }
                    },
                    "velocity_law": {
                        "type": "model_description",
                        "model_type": "velocity_law_hht",
                        "time": "time",
                        "disp": "cavity.dynamics.disp"
                    },
                    "rheology": {
                        "type": "model_description",
                        "model_type": "rheology_fiber_additive",
                        "time": "time",
                        "disp": "cavity.dynamics.disp",
                        "active_tension_discr": "cavity.rheology.active_law.active_tension_discr",
                        "radius": "heart_radius",
                        "alternative_types": {
                            "cavity.asymptotic": "rheology_fiber_additive_asymptotic"
                        },
                        "submodels": {
                            "active_law": {
                                "type": "model_description",
                                "model_type": "active_law_macro_huxley_two_moments",
                                "time": "time",
                                "fib_deform": "cavity.rheology.fib_deform",
                                "contractility": "heart_contractility",
                                "alternative_types": {
                                    "cavity.asymptotic": "active_law_macro_huxley_two_moments_asymptotic"
                                }
                            }
                        }
                    }
                },
                "nodes": {
                    "1": "cavity"
                }
            },
            "valve_atrium": {
                "type": "block_description",
                "model_type": "valve_rl_block",
                "time": "time",
                "flux_type": "blood_flow",
                "backward_conductance": "conductance_iso",
                "nodes": {
                    "1": "atrial",
                    "2": "cavity"
                }
            },
            "valve_arterial": {
                "type": "block_description",
                "model_type": "valve_rl_block",
                "time": "time",
                "flux_type": "blood_flow",
                "backward_conductance": "conductance_iso",
                "nodes": {
                    "1": "cavity",
                    "2": "aorta_proximal"
                }
            },
            "capacitance_valve": {
                "type": "block_description",
                "model_type": "c_block",
                "time": "time",
                "flux_type": "blood_flow",
                "nodes": {
                    "1": "cavity"
                }
            },
            "circulation_aorta_proximal": {
                "type": "block_description",
                "model_type": "rc_block",
                "time": "time",
                "flux_type": "blood_flow",
                "nodes": {
                    "1": "aorta_distal",
                    "2": "aorta_proximal"
                }
            },
            "circulation_aorta_distal": {
                "type": "block_description",
                "model_type": "rc_block",
                "time": "time",
                "flux_type": "blood_flow",
                "nodes": {
                    "1": "venous",
                    "2": "aorta_distal"
                }
            }
        },
        "boundaries_conditions": {
            "atrial": [
                {
                    "type": "condition",
                    "condition_type": "blood_pressure",
                    "condition_id": "atrial.blood_pressure"
                }
            ],
            "venous": [
                {
                    "type": "condition",
                    "condition_type": "blood_pressure",
                    "condition_id": "venous.blood_pressure"
                }
            ]
        }
    },
    "state": {
        "valve_atrium.flux": {
            "type": "quantity",
            "magnitude": 0.001,
            "stdev": 1e-06
        },
        "valve_arterial.flux": {
            "type": "quantity",
            "magnitude": 0.001,
            "stdev": 1e-06
        },
        "cavity.dynamics.disp": {
            "type": "quantity",
            "magnitude": 0.01,
            "value": 0.001,
            "stdev": 0.01
        },
        "cavity.velocity_law.vel": {
            "type": "quantity",
            "magnitude": 0.1,
            "stdev": 0.0001
        },
        "cavity.velocity_law.accel": {
            "type": "quantity",
            "magnitude": 1.0,
            "stdev": 0.01
        },
        "cavity.rheology.fib_deform": {
            "type": "quantity",
            "magnitude": 0.1,
            "stdev": 0.01
        },
        "cavity.rheology.active_law.active_stiffness": {
            "type": "quantity",
            "value": 10.0,
            "magnitude": 100000.0,
            "stdev": 1.0
        },
        "cavity.rheology.active_law.active_energy_sqrt": {
            "type": "quantity",
            "value": 0.0,
            "magnitude": 100.0,
            "stdev": 0.001
        },
        "cavity.rheology.active_law.active_tension_discr": {
            "type": "quantity",
            "value": 0.0,
            "magnitude": 10000.0,
            "stdev": 0.001
        },
        "cavity.blood_pressure": {
            "type": "quantity",
            "value": "cavity.blood_pressure.init",
            "magnitude": 10000.0,
            "stdev": 0.01
        },
        "aorta_proximal.blood_pressure": {
            "type": "quantity",
            "value": "aorta_proximal.blood_pressure.init",
            "magnitude": 10000.0,
            "stdev": 0.01
        },
        "aorta_distal.blood_pressure": {
            "type": "quantity",
            "value": "aorta_distal.blood_pressure.init",
            "magnitude": 10000.0,
            "stdev": 0.01
        }
    },
    "observer": {
        "type": "observer",
        "observations": {
            "observation.aorta_proximal.blood_pressure": {
                "type": "observation",
                "measurement": "measurement.aorta_proximal.blood_pressure",
                "operator": {
                    "type": "watch_quantity",
                    "evaluation_quantities": {
                        "quantity": "aorta_proximal.blood_pressure"
                    }
                },
                "magnitude": 10000.0,
                "stdev": 0.05
            },
            "observation.valve_arterial.flux": {
                "type": "observation",
                "measurement": "measurement.valve_arterial.flux",
                "operator": {
                    "type": "watch_quantity",
                    "evaluation_quantities": {
                        "quantity": "valve_arterial.flux"
                    }
                },
                "magnitude": 1e-06,
                "stdev": 0.05
            }
        }
    },
    "estimated_parameters": {
        "circulation_aorta_distal.resistance": {
            "type": "quantity",
            "value": "circulation_aorta_distal.resistance.init",
            "stdev": 0.1,
            "magnitude": 100000000.0
        },
        "heart_contractility": {
            "type": "quantity",
            "value": "heart_contractility.init",
            "stdev": 0.1,
            "magnitude": 100000.0
        }
    },
    "update_functions": {
        "cavity.rheology.active_law.activation": {
            "type": "rescale_two_phases_function",
            "rescaled_period": "heartbeat_duration",
            "alpha": "diastole_scaling_factor",
            "reference_function": [
                [
                    0.0,
                    "active_law.activation.min"
                ],
                [
                    0.027,
                    "active_law.activation.min"
                ],
                [
                    0.037,
                    0.0
                ],
                [
                    0.145,
                    "active_law.activation.max"
                ],
                [
                    0.309,
                    "active_law.activation.max"
                ],
                [
                    0.417,
                    0.0
                ],
                [
                    0.427,
                    "active_law.activation.min"
                ],
                [
                    0.9,
                    "active_law.activation.min"
                ]
            ],
            "phases": [
                0,
                0,
                1,
                1,
                1,
                0,
                0
            ],
            "evaluation_quantities": {
                "time": "time"
            }
        },
        "atrial.blood_pressure": {
            "type": "rescale_two_phases_function",
            "rescaled_period": "heartbeat_duration",
            "alpha": "diastole_scaling_factor",
            "reference_function": [
                [
                    0.0,
                    "atrial.blood_pressure.max"
                ],
                [
                    0.02,
                    "atrial.blood_pressure.max"
                ],
                [
                    0.07,
                    "atrial.blood_pressure.min"
                ],
                [
                    0.84,
                    "atrial.blood_pressure.min"
                ],
                [
                    0.9,
                    "atrial.blood_pressure.max"
                ]
            ],
            "phases": [
                1,
                1,
                0,
                1
            ],
            "evaluation_quantities": {
                "time": "time"
            }
        }
    },
    "output_functions": {
        "atrial.blood_pressure": {
            "type": "watch_quantity",
            "evaluation_quantities": {
                "quantity": "atrial.blood_pressure"
            }
        },
        "active_law.activation": {
            "type": "watch_quantity",
            "evaluation_quantities": {
                "quantity": "cavity.rheology.active_law.activation"
            }
        }
    },
    "data": {
        "measurements": {
            "type": "read_data",
            "filepath": "../synthetic_data/spherical_heart_measurements.csv"
        }
    },
    "preprocesses": {
        "measurements_mapping": {
            "type": "rename_process",
            "inputs": [
                "measurements"
            ],
            "outputs": [
                "measurements"
            ],
            "mapping": {
                "proximal_pressure": "measurement.aorta_proximal.blood_pressure",
                "proximal_flow": "measurement.valve_arterial.flux"
            }
        },
        "interpolate_measurements": {
            "type": "interpolation_process",
            "inputs": [
                "measurements"
            ],
            "outputs": [
                "measurements"
            ],
            "abscissas": "time",
            "abscissas_start": "time.start",
            "abscissas_length": "time.duration",
            "abscissas_step": "time.step"
        },
        "SI_unit_conversion": {
            "type": "conversion_process",
            "inputs": [
                "measurements"
            ],
            "outputs": [
                "measurements"
            ],
            "conversion_factors": {
                "measurement.aorta_proximal.blood_pressure": 133.32231202220615,
                "measurement.valve_arterial.flux": 1e-06
            }
        }
    },
    "postprocesses": {
        "extract_last_cycle": {
            "type": "drop_process",
            "inputs": [
                "main"
            ],
            "outputs": [
                "last_cycle"
            ],
            "abscissas_name": "time",
            "abscissas_interval": [
                "time.start",
                {
                    "type": "sum",
                    "add": [
                        "time.start",
                        "time.duration"
                    ],
                    "subtract": [
                        "heartbeat_duration"
                    ]
                }
            ]
        },
        "ESPVR-EDPVR": {
            "type": "compute_espvr_edpvr",
            "alternative_cavity_id": "cavity.asymptotic",
            "displacement_id": "cavity.dynamics.disp",
            "displacement_range": {
                "type": "range",
                "start": -0.002,
                "length": 0.013,
                "step_size": 1e-05
            },
            "outputs": [
                "espvr-edpvr"
            ]
        },
        "medical_units_conversion": {
            "type": "conversion_process",
            "conversion_factors": {
                "valve_atrium.flux": 1000000.0,
                "stdev_plus.valve_atrium.flux": 1000000.0,
                "stdev_min.valve_atrium.flux": 1000000.0,
                "valve_arterial.flux": 1000000.0,
                "measurement.valve_arterial.flux": 1000000.0,
                "stdev_plus.valve_arterial.flux": 1000000.0,
                "stdev_min.valve_arterial.flux": 1000000.0,
                "aorta_proximal.blood_pressure": 0.00750062,
                "measurement.aorta_proximal.blood_pressure": 0.00750062,
                "stdev_plus.aorta_proximal.blood_pressure": 0.00750062,
                "stdev_min.aorta_proximal.blood_pressure": 0.00750062,
                "aorta_distal.blood_pressure": 0.00750062,
                "stdev_plus.aorta_distal.blood_pressure": 0.00750062,
                "stdev_min.aorta_distal.blood_pressure": 0.00750062,
                "cavity.blood_pressure": 0.00750062,
                "stdev_plus.cavity.blood_pressure": 0.00750062,
                "stdev_min.cavity.blood_pressure": 0.00750062,
                "atrial.blood_pressure": 0.00750062,
                "pleural.pressure": 0.0102,
                "cavity.volume": 1000000.0,
                "cavity.dynamics.EDPVR": 0.00750062,
                "cavity.dynamics.ESPVR": 0.00750062
            },
            "inputs": [
                "main",
                "espvr-edpvr",
                "measurements",
                "last_cycle"
            ],
            "outputs": [
                "main",
                "espvr-edpvr",
                "measurements",
                "last_cycle"
            ]
        }
    }
}