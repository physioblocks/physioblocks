{
    "type": "estimation_simulation",
    "filter_type": "unscented_kalman_filter",
    "solver": {"type": "linear_solver"},
    "time": {
        "type": "range",
        "start": 0.0,
        "length": 10.0,
        "step_size": 0.001
    },
    "simulation_options": {
        "model_noise_stdev": {
            "A.pressure": 1e-4,
            "B.pressure": 1e-4,
            "Rb": 1e-4
        },
        "transformation_operators": {
            "Rb": {"type": "power_transform", "scaling_factor": 1.0e8}
        }
    },
    "net": {
        "type": "simple_circulation_net",
        "boundaries_conditions": {
            "C": [{"type": "condition", "condition_type": "pressure", "condition_id": "C.pressure"}],
            "A": [{"type": "condition", "condition_type": "flow", "condition_id": "A.flow"}]
        }
    },
    "state": {
        "A.pressure": {
            "type": "quantity",
            "value": 0.0,
            "magnitude": 1e5,
            "stdev": 0.01
        },
        "B.pressure": {
            "type": "quantity",
            "value": 0.0,
            "magnitude": 1e5,
            "stdev": 0.01
        }
    },
    "estimated_parameters": {
        "Rb": {
            "type": "quantity",
            "value": 5.0e8, // wrong initial guess
            "magnitude": 1e8,
            "stdev": 0.5 // large standard deviation
        }
    },
    "parameters": {
        "Ca": 2.0e-10,
        "Ra": 8.0e6,
        "Cb": 1.7e-08,
        "C.pressure": 1.6e3,
        "heartbeat_duration": 1.0
    },
    "update_functions": {
        "A.flow": {"type": "flow_pulse_function"}
    },
    "data": {
        "measurements": {
            "type": "read_data",
            "filepath": "synthetic_data.csv"
        }
    },
    "preprocesses": {
        "rename_measurements": {
            "type": "rename_process",
            "inputs": ["measurements"],
            "outputs": ["measurements"],
            "mapping": {"A.pressure": "measurement.A.pressure"}
        }
    },
    "observer": {
        "type": "observer",
        "observations": {
            "observation.A.pressure": {
                "type": "observation",
                "measurement": "measurement.A.pressure",
                "operator": {
                    "type": "watch_quantity",
                    "evaluation_quantities": {"quantity": "A.pressure"}
                },
                "magnitude": 1e5,
                "stdev": 1e-4
            }
        }
    },
    "plots": {
        "estimation_results": {
            "type": "subplots_estimation",
            "abscissas": "time",
            "inputs": ["main", "measurements"],
            "subplots": ["A.pressure", "B.pressure", "Rb"],
            "layout":{
                "xaxis1_title": "time (s)",
                "xaxis2_title": "time (s)",
                "xaxis3_title": "time (s)",
                "yaxis1_title": "pressure (Pa)",
                "yaxis2_title": "pressure (Pa)",
                "yaxis3_title": "resistance (Pa.s.m-3)"
            }
        }
    }
}
