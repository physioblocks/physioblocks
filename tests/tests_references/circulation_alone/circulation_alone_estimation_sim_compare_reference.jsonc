{
    "type": "../../../references/circulation_alone_estimation_sim.jsonc",
    "data": {
        "measurements": {
            "filepath": "../../../references/synthetic_data/spherical_heart_measurements.csv"
        }
    },
    "postprocesses": {
        "compare_reference_simulation": {
            "type": "compare_process",
            "inputs": ["main"],
            "outputs": ["main_error"],
            "abscissas": "time",
            "reference": "ref_circulation_alone_estimation_ukf_sim.csv"
        }
    },
    "plots":{
        "plot_error_main": {
            "type": "plot",
            "inputs": ["main_error"],
            "abscissas": "time"
        }
    }
}
