{
    "type": "./references/circulation_alone_estimation_sim.jsonc",
    "postprocesses": {
        "compare_reference_simulation": {
            "type": "compare_process",
            "inputs": ["main"],
            "outputs": ["main_error"],
            "abscissas": "time",
            "reference": "./tests/tests_references/circulation_alone/ref_circulation_alone_estimation_ukf_sim.csv"
        }
    },
    "plots":{
        "plot_error_main": {
            "type": "plot",
            "inputs": ["main_error"],
            "abscissas": "time"
        }
    }
}
