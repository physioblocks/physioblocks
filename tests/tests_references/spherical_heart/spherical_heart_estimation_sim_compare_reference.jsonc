{
    "type": "../../../references/spherical_heart_estimation_sim.jsonc",
    "data": {
        "measurements": {
            "filepath": "../../../references/synthetic_data/spherical_heart_measurements.csv"
        }
    },
    "postprocesses": {
        "compare_reference_simulation": {
            "type": "compare_process",
            "inputs": ["main"],
            "outputs": ["main_error"],
            "abscissas": "time",
            "reference": "ref_spherical_heart_estimation_sim.csv"
        },"compare_reference_espvr_edpvr": {
            "type": "compare_process",
            "inputs": ["espvr-edpvr"],
            "outputs": ["espvr-edpvr_error"],
            "abscissas": "cavity.dynamics.disp",
            "reference": "ref_spherical_heart_estimation_sim_espvr_edpvr.csv"
        }
    },
    "plots": {
        "plot_error_main": {
            "type": "plot",
            "inputs": ["main_error"],
            "abscissas": "time"
        },
        "plot_error_espvr_edpvr": {
            "type": "plot",
            "inputs": ["espvr-edpvr_error"],
            "abscissas": "cavity.dynamics.disp"
        }
    }
}

