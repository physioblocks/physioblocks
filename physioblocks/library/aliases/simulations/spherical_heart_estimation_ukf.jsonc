{
    "type": "default_estimation_simulation",
    "filter_type": "unscented_kalman_filter",
    "simulation_options":{
        "model_noise_stdev": {
            "aorta_proximal.blood_pressure": 0.0002,
            "aorta_distal.blood_pressure": 0.0002,
            "valve_atrium.flux": 0.0002,
            "valve_arterial.flux": 0.0002,
            "cavity.dynamics.disp": 0.0,
            "cavity.velocity_law.vel": 0.0,
            "cavity.velocity_law.accel": 0.0,
            "cavity.rheology.fib_deform": 0.0002,
            "cavity.rheology.active_law.active_stiffness": 0.0002,
            "cavity.rheology.active_law.active_energy_sqrt": 0.0002,
            "cavity.rheology.active_law.active_tension_discr": 0.0002,
            "cavity.blood_pressure": 0.0002,
            "circulation_aorta_distal.resistance":0.0002,
            "heart_contractility": 0.0002
        },
        "transformation_operators": {
            "cavity.rheology.active_law.active_stiffness": {
                "type": "tanh_transform",
                "scaling_factor": 1.0e5,
                "upper_bound": "cavity.rheology.active_law.crossbridge_stiffness",
                "lower_bound": 0.0
            },
            "circulation_aorta_distal.resistance": {
                "type": "power_transform",
                "scaling_factor": 1.0e8
            },
            "heart_contractility":{
                "type": "power_transform",
                "scaling_factor": 1.0e5
            }
        },
        "parallelize": "True"
    },
    "net": {
        "type": "spherical_heart_net",
        "boundaries_conditions": {
            "atrial": [
                {
                    "type": "condition",
                    "condition_type": "blood_pressure",
                    "condition_id": "atrial.blood_pressure"
                }
            ],
            "venous": [
                {
                    "type": "condition",
                    "condition_type": "blood_pressure",
                    "condition_id": "venous.blood_pressure"
                }
            ]
        }
    },
    "state": {
        "valve_atrium.flux": {
            "type": "quantity",
            "magnitude": 0.001,
            "stdev": 1e-6
        },
        "valve_arterial.flux": {
            "type": "quantity",
            "magnitude": 0.001,
            "stdev": 1e-6
        },
        "cavity.dynamics.disp": {
            "type": "quantity",
            "magnitude": 0.01,
            "value": 0.001,
            "stdev": 0.01
        },
        "cavity.velocity_law.vel": {
            "type": "quantity",
            "magnitude": 0.1,
            "stdev": 1.0e-4
        },
        "cavity.velocity_law.accel": {
            "type": "quantity",
            "magnitude": 1.0,
            "stdev": 0.01
        },
        "cavity.rheology.fib_deform": {
            "type": "quantity",
            "magnitude": 0.1,
            "stdev": 0.01
        },
        "cavity.rheology.active_law.active_stiffness": {
            "type": "quantity",
            "value": 10.0,
            "magnitude": 1e5,
            "stdev": 1.0
        },
        "cavity.rheology.active_law.active_energy_sqrt": {
            "type": "quantity",
            "value" :0.0,
            "magnitude": 100.0,
            "stdev": 1.0e-3
        },
        "cavity.rheology.active_law.active_tension_discr": {
            "type": "quantity",
            "value": 0.0,
            "magnitude": 10000.0,
            "stdev": 1e-3
        },
        "cavity.blood_pressure": {
            "type": "quantity",
            "value": "cavity.blood_pressure.init",
            "magnitude": 10000.0,
            "stdev": 0.01
        },
        "aorta_proximal.blood_pressure": {
            "type": "quantity",
            "value": "aorta_proximal.blood_pressure.init",
            "magnitude": 10000.0,
            "stdev": 0.01
        },
        "aorta_distal.blood_pressure": {
            "type": "quantity",
            "value": "aorta_distal.blood_pressure.init",
            "magnitude": 10000.0,
            "stdev": 0.01
        }
    },
    "observer": {
        "type": "observer",
        "observations":{
            "observation.aorta_proximal.blood_pressure": {
                "type": "observation",
                "measurement": "measurement.aorta_proximal.blood_pressure",
                "operator": {
                    "type": "watch_quantity",
                    "evaluation_quantities": {"quantity": "aorta_proximal.blood_pressure"}
                },
                "magnitude": 1e4,
                "stdev": 0.05
            },
            "observation.valve_arterial.flux": {
                "type": "observation",
                "measurement": "measurement.valve_arterial.flux",
                "operator": {
                    "type": "watch_quantity",
                    "evaluation_quantities": {"quantity": "valve_arterial.flux"}
                },
                "magnitude": 1e-6,
                "stdev": 0.05
            }
        }
    },
    "estimated_parameters": {
        "circulation_aorta_distal.resistance": {
            "type": "quantity",
            "value": "circulation_aorta_distal.resistance.init",
            "stdev": 0.1,
            "magnitude": 1.0e8
        },
        "heart_contractility": {
            "type": "quantity",
            "value": "heart_contractility.init",
            "stdev": 0.1,
            "magnitude": 1.0e5
        }
    },
    "parameters": {

        // "Inverse the heart_rate to get the heartbeat period in seconds"
        // Required parameters initialization is:
        // heart_rate in beat / min
        "heartbeat_duration": {"type": "product", "factors": [60.0] , "inverses": ["heart_rate"]},
        "pleural.pressure": 0.0,
        "diastole_scaling_factor": 0.80,
        "time.step": 0.001,

        // dynamics section
        "cavity.dynamics.vol_mass": 1000.0,
        "cavity.dynamics.damping_coef": 70.0,
        
        // velocity law section
        "cavity.velocity_law.scheme_ts_hht": 0.4,

        // rheology section
        "cavity.rheology.series_stiffness": 100000000.0,
        "cavity.rheology.damping_parallel": 70.0,

        // active law section
        "cavity.rheology.active_law.starling_abscissas": [
            -0.1668,
            -0.0073,
            0.0534,
            0.0969,
            0.1326,
            0.2016,
            0.4663,
            0.9187,
            1.1762
        ],
        "cavity.rheology.active_law.starling_ordinates": [
            0.0,
            0.5614,
            0.7748,
            0.8933,
            0.9618,
            1.0,
            1.0,
            0.1075,
            0.0
        ],
        "cavity.rheology.active_law.destruction_rate": 12.0,
        "cavity.rheology.active_law.crossbridge_stiffness": 273000.0,

        // Parameters for the active law activation
        "active_law.activation.min": -20.0,
        "active_law.activation.max": 35.0,
        
        // valves section
        "conductance_iso": 5e-15,
        "valve_atrium.inductance": 1.0e3,
        "valve_atrium.conductance": 9e-06,
        "valve_arterial.inductance": 3.0e4,
        "valve_arterial.conductance": 1.3e-05,
        "capacitance_valve.capacitance": 5e-12,
        "valve_atrium.scheme_ts_flux": 0.25,
        "valve_arterial.scheme_ts_flux": 0.25,

        // circulation section
        "circulation_aorta_proximal.capacitance": 2.0e-10,
        "circulation_aorta_distal.capacitance": 1.2e-8
        
        // initialize the distal capacitance from the distal time constant and resistance (Cc = tc / Rc)
        // Required parameters initialization is: "circulation_aorta_distal.time_constant"
        // "circulation_aorta_distal.capacitance": {
        //     "type": "product",
        //     "factors": ["circulation_aorta_distal.time_constant"],
        //     "inverses": ["circulation_aorta_distal.resistance.init"]
        // }
    },
    "update_functions":{
        // Parametrize the active law activation
        // Required parameters initialization are:
        // heartbeat_duration
        // active_law.activation.min
        // active_law.activation.max
        "cavity.rheology.active_law.activation": {
            "type": "rescale_two_phases_function",
            "rescaled_period": "heartbeat_duration",
            "alpha": "diastole_scaling_factor",
            "reference_function": [
                [0.0, "active_law.activation.min"],
                [0.027, "active_law.activation.min"],
                [0.037, 0.0],
                [0.145, "active_law.activation.max"],
                [0.309, "active_law.activation.max"],
                [0.417, 0.0],
                [0.427, "active_law.activation.min"],
                [0.9, "active_law.activation.min"]
            ],
            "phases": [0, 0, 1, 1, 1, 0, 0],
            "evaluation_quantities": {"time": "time"}
        },
        // Section to parametrize the atrial blood pressure
        // Required parameters initialization are:
        // heartbeat_duration
        // atrial.blood_pressure.min
        // atrial.blood_pressure.max
        "atrial.blood_pressure": {
            "type": "rescale_two_phases_function",
            "rescaled_period": "heartbeat_duration",
            "alpha": "diastole_scaling_factor",
            "reference_function": [
                [0.0, "atrial.blood_pressure.max"],
                [0.02, "atrial.blood_pressure.max"],
                [0.07, "atrial.blood_pressure.min"],
                [0.84, "atrial.blood_pressure.min"],
                [0.9, "atrial.blood_pressure.max"]
            ],
            "phases": [1, 1, 0, 1],
            "evaluation_quantities": {"time": "time"}
        }
    },
    "output_functions": {
        "atrial.blood_pressure": {"type": "watch_quantity", "evaluation_quantities": {"quantity": "atrial.blood_pressure"}},
        "active_law.activation": {"type": "watch_quantity", "evaluation_quantities": {"quantity": "cavity.rheology.active_law.activation"}}
    },
    "data": {
        "measurements": {
            "type": "read_data"
            // "filepath": ""
        }
    },
    "preprocesses": {
        "measurements_mapping": {
            "type": "rename_process",
            "inputs": ["measurements"],
            "outputs": ["measurements"]
        },
        "interpolate_measurements":{
            "type": "interpolation_process",
            "inputs": ["measurements"],
            "outputs": ["measurements"], // override data
            "abscissas": "time",
            "abscissas_start": "time.start",
            "abscissas_length": "time.duration",
            "abscissas_step": "time.step"
        },
        "SI_unit_conversion": {
            "type": "conversion_process",
            "inputs": ["measurements"],
            "outputs": ["measurements"],
            "conversion_factors": {
                "measurement.aorta_proximal.blood_pressure": 133.32231202220615, // mmHg to Pa
                "measurement.valve_arterial.flux": 1e-6 // mL/s to m3/s
            }
        }
    },
    "postprocesses": {
        "extract_last_cycle": {
            "type": "drop_process",
            "inputs": ["main"],
            "outputs": ["last_cycle"],
            "abscissas_name": "time",
            "abscissas_interval": [
                "time.start",
                {
                    "type": "sum",
                    "add": ["time.start", "time.duration"],
                    "subtract": ["heartbeat_duration"]
                }
            ]
        },
        "ESPVR-EDPVR": {
            "type": "compute_espvr_edpvr",
            "alternative_cavity_id": "cavity.asymptotic",
            "displacement_id": "cavity.dynamics.disp",
            "displacement_range":{
                "type": "range",
                "start": -0.002,
                "length": 0.013,
                "step_size": 1e-5
            },
            "outputs": ["espvr-edpvr"]
        },
        "medical_units_conversion": {
            "type": "conversion_process",
            "conversion_factors": {
                "valve_atrium.flux": 1.0e6, // m3/s to mL/s
                "stdev_plus.valve_atrium.flux": 1.0e6, // m3/s to mL/s
                "stdev_min.valve_atrium.flux": 1.0e6, // m3/s to mL/s
                "valve_arterial.flux": 1.0e6, // m3/s to mL/s
                "measurement.valve_arterial.flux": 1.0e6, // m3/s to mL/s
                "stdev_plus.valve_arterial.flux": 1.0e6, // m3/s to mL/s
                "stdev_min.valve_arterial.flux": 1.0e6, // m3/s to mL/s
                "aorta_proximal.blood_pressure": 0.00750062, // Pa to mmHg
                "measurement.aorta_proximal.blood_pressure": 0.00750062, // Pa to mmHg
                "stdev_plus.aorta_proximal.blood_pressure": 0.00750062,
                "stdev_min.aorta_proximal.blood_pressure": 0.00750062,
                "aorta_distal.blood_pressure": 0.00750062, // Pa to mmHg
                "stdev_plus.aorta_distal.blood_pressure": 0.00750062,
                "stdev_min.aorta_distal.blood_pressure": 0.00750062,
                "cavity.blood_pressure": 0.00750062, // Pa to mmHg
                "stdev_plus.cavity.blood_pressure": 0.00750062, // Pa to mmHg
                "stdev_min.cavity.blood_pressure": 0.00750062, // Pa to mmHg
                "atrial.blood_pressure": 0.00750062, // Pa to mmHg
                "pleural.pressure": 0.0102, // Pa to cmH20
                "cavity.volume": 1.0e6, // m3 to mL
                "cavity.dynamics.EDPVR": 0.00750062, // Pa to mmHg
                "cavity.dynamics.ESPVR": 0.00750062 // Pa to mmHg
            },
            "inputs": ["main", "espvr-edpvr", "measurements", "last_cycle"],
            "outputs": ["main", "espvr-edpvr", "measurements", "last_cycle"] // overwrite simulations results
        }
    }, 
    "plots":{
        "PV-Loop_plot": {
            "type": "plot_pv_loop",
            "abscissas": "cavity.volume",
            "layout": {
                "annotations": [{"text":  "Cavity PV Loop"}],
                "xaxis_title": "Volume (mL)",
                "yaxis_title": "Pressure (mmHg)"
            },
            "subplots": ["cavity"],
            "inputs": ["last_cycle", "espvr-edpvr"]
        },
        "estimations": {
            "type": "subplots_estimation",
            "abscissas": "time",
            "subplots": [
                "aorta_proximal.blood_pressure",
                "valve_arterial.flux",
                "circulation_aorta_distal.resistance",
                "heart_contractility",
                "cavity.blood_pressure",
                "atrial.blood_pressure",
                "aorta_distal.blood_pressure",
                "valve_atrium.flux",
                "cavity.volume",
                "cavity.dynamics.disp",
                "cavity.velocity_law.vel",
                "cavity.velocity_law.accel",
                "cavity.rheology.fib_deform",
                "active_law.activation",
                "cavity.rheology.active_law.active_stiffness",
                "cavity.rheology.active_law.active_energy_sqrt",
                "cavity.rheology.active_law.active_tension_discr"
            ],
            "inputs": ["main", "measurements"]
        }
    }
}